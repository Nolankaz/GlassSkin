# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# Found under Project Settings -> Data API.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API key used by the backend.
# The backend currently talks to Supabase with no end-user auth, so this key is
# the only thing standing between a request and the data. It is a secret server
# key, which is a privileged credential: keep it server-side only, never expose
# it to the browser, and do not assume Row Level Security constrains requests
# made with it. Choosing the right key class is part of the Day 20 auth work.
SUPABASE_KEY=your-supabase-api-key

# OpenAI API key used by services/treatment_research.py.
# Every uncached call to the treatment-research endpoint spends real money.
OPENAI_API_KEY=sk-your-openai-key

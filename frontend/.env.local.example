# Copy this file to frontend/.env.local for local development.
# .env.local is git-ignored.
#
# Base URL of the FastAPI backend. Read by frontend/lib/api.ts.
# Leave it unset locally and the app falls back to http://127.0.0.1:8000.
# Set it to the deployed backend origin in production.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
